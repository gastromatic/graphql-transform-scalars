{
  "name": "graphql-transform-scalars",
  "version": "2.3.0",
  "description": "Graphql response transformer for custom scalars",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "bun run clean && bun run compile",
    "clean": "rimraf ./dist",
    "compile": "tsc -p tsconfig.build.json",
    "graphql:test:generate": "graphql-codegen --config test/codegen.yml",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "tsc:check": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt ."
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gastromatic/graphql-transform-scalars.git"
  },
  "keywords": [
    "javascript",
    "typescript",
    "graphql",
    "scalars",
    "customer scalars",
    "graphql-transform-scalars"
  ],
  "author": "Patrick Klein",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gastromatic/graphql-transform-scalars/issues"
  },
  "homepage": "https://github.com/gastromatic/graphql-transform-scalars#readme",
  "peerDependencies": {
    "graphql": ">=15"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@graphql-codegen/add": "8.0.0",
    "@graphql-codegen/cli": "8.0.0",
    "@graphql-codegen/typescript": "7.0.1",
    "@graphql-codegen/typescript-graphql-request": "8.0.2",
    "@graphql-codegen/typescript-operations": "7.0.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "calendar-date": "3.0.0",
    "fast-check": "4.10.2",
    "graphql": "17.1.0",
    "graphql-request": "7.4.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "rimraf": "6.1.4",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
